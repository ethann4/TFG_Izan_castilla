mixin ShopCategory
  section.py-7#categorias
    .container
      .row.mb-4
        .col-lg-7
          .cdp-section-kicker Categorias futuras
          h2.cdp-section-title Volantes por marca
      .row.g-4
        .col-md-3
          a.cdp-card.p-4.d-block.text-decoration-none(href='Catalogo.html?brand=bmw#catalogo-grid')
            h5.text-light BMW
            p.mb-0.text-500 E46 / E39, E90 / E60 y Serie F.
        .col-md-3
          a.cdp-card.p-4.d-block.text-decoration-none(href='Catalogo.html?brand=audi#catalogo-grid')
            h5.text-light Audi
            p.mb-0.text-500 S-Line y RS.
        .col-md-3
          a.cdp-card.p-4.d-block.text-decoration-none(href='Catalogo.html?brand=mercedes#catalogo-grid')
            h5.text-light Mercedes
            p.mb-0.text-500 AMG Line.
        .col-md-3
          a.cdp-card.p-4.d-block.text-decoration-none(href='Catalogo.html?brand=volkswagen#catalogo-grid')
            h5.text-light Volkswagen
            p.mb-0.text-500 GTI, R y OEM+.
