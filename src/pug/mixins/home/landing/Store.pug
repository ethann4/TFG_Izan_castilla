mixin Testimonials
  section.bg-black.py-8#nosotros
    +Background({ image: `${CWD}assets/img/gallery/bmw_hero_banner.jpg`, attrs: { style: { 'background-position': 'right center', 'background-size': 'cover'} }, className: 'store-bg-holder' })
    .container-lg
      .row.align-items-center
        .col-lg-6.ms-lg-auto
          .cdp-section-kicker Taller y venta especializada
          h2.cdp-section-title Volantes con identidad propia
          p.cdp-section-copy CDP Customs nace en Vizcaya con una idea clara: transformar el punto de contacto mas importante del conductor en una pieza unica, comoda y coherente con el coche.
          .d-flex.flex-wrap.gap-2.mt-4
            span.cdp-pill Tapizado artesanal
            span.cdp-pill Compatibilidad por modelo
            span.cdp-pill Pedido personalizado
