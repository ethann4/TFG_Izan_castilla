mixin Collection
  section.py-7#catalogo-preview
    .container
      .row.align-items-end.mb-4
        .col-lg-7
          .cdp-section-kicker Catalogo destacado
          h2.cdp-section-title.mb-0 Novedades CDP
        .col-lg-5.text-lg-end.mt-3.mt-lg-0
          a.btn.btn-outline-primary(href='Catalogo.html') Abrir catalogo completo
      .row.g-4
        .col-md-4
          a.home-product-card(href='producto.html?id=e46-carbono-galaxy-rpm')
            img(src='assets/img/gallery/E46/E46_pantalla_galaxy_carbono.png' alt='Volante BMW E46 carbono galaxy RPM')
            span BMW E46 / E39
            strong Carbono Galaxy RPM
            em 1.200 EUR
        .col-md-4
          a.home-product-card(href='producto.html?id=e90-alcantara-rpm-amarillo')
            img(src='assets/img/gallery/E90/E60_ALCANTARA_PANTALLA_LEVAS_AMARILLO.png' alt='Volante BMW E90 alcantara RPM')
            span BMW E90 / E60
            strong Alcantara RPM Amarillo
            em 1.000 EUR
        .col-md-4
          a.home-product-card(href='producto.html?id=f82-carbono-cuero-m')
            img(src='assets/img/gallery/F82/F82_Carbono_cuero.png' alt='Volante BMW F82 carbono cuero')
            span BMW Serie F
            strong Carbono Cuero M
            em 550 EUR
