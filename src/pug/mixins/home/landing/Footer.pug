mixin Footer
  section.py-7.cdp-footer#contact
    .container
      .row.g-4
        .col-md-4
          img.footer-logo.mb-3(src='assets/img/logo_cdp_transparente.png' alt='CDP Customs')
          p Personalizacion y venta de volantes premium para proyectos de automocion con identidad propia.
        .col-md-2
          .cdp-footer-title.mb-3 Menu
          ul.list-unstyled
            li
              a(href='Catalogo.html') Catalogo
            li
              a(href='Creacionvirtual.html') Configurador
            li
              a(href='contacto.html') Contacto
        .col-md-3
          .cdp-footer-title.mb-3 Proyecto DAW
          ul.list-unstyled
            li Frontend HTML, CSS y JS
            li Base preparada para PHP/MySQL
            li CRUD futuro de productos y pedidos
        .col-md-3
          .cdp-footer-title.mb-3 Contacto
          p.mb-1 Vizcaya, Espana
          p.mb-1
            a(href='tel:+34676525005') (+34) 676 525 005
          p.mb-1
            a(href='mailto:info@cdpcustoms.local') info@cdpcustoms.local
          p.mb-0
            a(href='https://instagram.com/cdp.performanceparts' target='_blank' rel='noreferrer') @cdp.performanceparts
      .border-bottom.border-700.my-4
      .d-flex.flex-column.flex-md-row.justify-content-between.gap-3
        span CDP Customs - Proyecto final DAW
        span Bootstrap adaptado y profesionalizado
