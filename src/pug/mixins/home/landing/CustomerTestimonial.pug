mixin CustomerTestimonials
  section.py-7#testing
    .container
      .row
        .col-lg-7.mx-auto.text-center.mb-5
          .cdp-section-kicker Calidad y pruebas
          h5.fs-3.fs-lg-5.lh-sm.mb-0.text-uppercase Proceso verificable
      .row.g-4
        .col-md-4
          .cdp-card.p-4.h-100
            h6.text-light.text-uppercase Compatibilidad
            p.mb-0 Se documenta marca, modelo, material y precio para validacion posterior en backend.
        .col-md-4
          .cdp-card.p-4.h-100
            h6.text-light.text-uppercase Pedido
            p.mb-0 El formulario queda preparado para almacenar solicitudes personalizadas con PHP y MySQL.
        .col-md-4
          .cdp-card.p-4.h-100
            h6.text-light.text-uppercase Administracion
            p.mb-0 La maqueta admin define el futuro CRUD de productos, modelos y pedidos.
