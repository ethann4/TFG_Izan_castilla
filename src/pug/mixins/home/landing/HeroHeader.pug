mixin HeroHeader
  section.py-0.cdp-hero#header
    +Background({ image: `${CWD}assets/img/gallery/header-bg.png`, attrs: { style: { 'background-position': 'left center', 'background-size': 'contain'} }, className: 'hero-bg-holder' })
    .container
      .row.align-items-center.justify-content-end.min-vh-75.min-vh-xl-100
        .col-md-8.col-lg-6.text-md-end.text-center
          .cdp-section-kicker.mb-3 CDP Customs
          h1.display-1.lh-sm.text-uppercase.text-light Disena tu volante
            br.d-none.d-xxl-block
            | a medida
          p.cdp-section-copy.hero-copy.ms-md-auto Personalizacion premium para interiores deportivos: cuero, alcantara, carbono, costuras, levas y pantallas RPM.
          .pt-4
            a.btn.btn-sm.btn-primary.me-3(href='Catalogo.html') Ver catalogo
            a.btn.btn-sm.btn-outline-primary(href='Creacionvirtual.html') Crear volante
