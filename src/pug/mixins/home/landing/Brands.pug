mixin Brand(image, label, link)
  .col-sm-6.col-lg-3.mb-4.mb-lg-0.d-flex.flex-center
    a.brand-tile(href=link)
      img(src=`assets/img/gallery/${image}` alt=label)

mixin Brands
  section.py-6.bg-dark#marcas
    .container
      .row
        +Brand('MERCEDES.png', 'Mercedes', 'Catalogo.html?brand=mercedes#catalogo-grid')
        +Brand('AUDI.png', 'Audi', 'Catalogo.html?brand=audi#catalogo-grid')
        +Brand('Volkswagen.png', 'Volkswagen', 'Catalogo.html?brand=volkswagen#catalogo-grid')
        +Brand('bmw.png', 'BMW', 'Catalogo.html?brand=bmw#catalogo-grid')
