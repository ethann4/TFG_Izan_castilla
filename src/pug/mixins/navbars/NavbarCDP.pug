mixin NavbarCDP
  nav.navbar.navbar-expand-lg.navbar-light.fixed-top.py-4.d-block.cdp-navbar(data-navbar-on-scroll)
    .container
      a.navbar-brand.d-inline-flex.align-items-center(href='index.html')
        img.navbar-logo.navbar-logo--tall(src='assets/img/logo_cdp_transparente.png' alt='CDP Customs')
      button.navbar-toggler.collapsed(type='button' data-bs-toggle='collapse' data-bs-target='#navbarSupportedContent' aria-controls='navbarSupportedContent' aria-expanded='false' aria-label='Abrir navegacion')
        span.navbar-toggler-icon
      #navbarSupportedContent.collapse.navbar-collapse.border-top.border-lg-0.mt-4.mt-lg-0
        ul.navbar-nav.me-auto.mb-2.mb-lg-0
          li.nav-item.fs-3.px-2
            a.nav-link.fw-bold(href='index.html' class= currentPage === 'index' ? 'active' : false) INICIO
          li.nav-item.fs-3.px-2
            a.nav-link.fw-bold(href='Catalogo.html') TIENDA
          li.nav-item.fs-3.px-2
            a.nav-link.fw-bold(href='Creacionvirtual.html') CONFIGURADOR
          li.nav-item.fs-3.px-2
            a.nav-link.fw-bold(href='contacto.html') CONTACTO
        .cdp-navbar-actions.d-flex.gap-3.align-items-center
          .cdp-header-tools(aria-label='Preferencias y cuenta')
            .dropdown
              button#cdpLanguageDropdown.cdp-tool-select.dropdown-toggle(type='button' data-bs-toggle='dropdown' aria-expanded='false' data-cdp-preference='language')
                span(data-cdp-label) Español
                span(data-feather='chevron-down')
              ul.cdp-tools-menu.dropdown-menu(aria-labelledby='cdpLanguageDropdown')
                li
                  button.dropdown-item(type='button' data-cdp-preference-target='language' data-cdp-option='Español') Español
                li
                  button.dropdown-item(type='button' data-cdp-preference-target='language' data-cdp-option='English') English
                li
                  button.dropdown-item(type='button' data-cdp-preference-target='language' data-cdp-option='Français') Français
            a.cdp-header-icon(href='Catalogo.html#catalogo' aria-label='Buscar productos')
              span(data-feather='search')
            a.cdp-header-icon(href='admin/index.html' aria-label='Usuario')
              span(data-feather='user')
            a.cdp-header-icon(href='Catalogo.html' aria-label='Carrito')
              span(data-feather='shopping-bag')
              span.cdp-cart-count 1
